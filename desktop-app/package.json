{
  "name": "magsika-reminder",
  "version": "1.0.3",
  "description": "Desktop reminder — notifikasi native + alarm full-screen buat tim Magsika Studio, jalan di background walau browser tidak dibuka.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.magsikastudio.reminder",
    "productName": "Magsika Reminder",
    "files": [
      "**/*",
      "!README.md",
      "!rustdesk-setup/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "https://workspace.magsikastudio.com/downloads/desktop-app/"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
